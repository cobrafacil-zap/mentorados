# =========================================================
# .env.example — TEMPLATE das variáveis de ambiente.
# Copie este arquivo para `.env` e preencha com seus valores.
#
# No Supabase (https://supabase.com/dashboard):
#   1. Settings → Database → Connection string → "Transaction" (pooled)
#      → copie para DATABASE_URL (porta 6543, com ?pgbouncer=true)
#   2. Settings → Database → Connection string → "Direct" (não pooled)
#      → copie para DIRECT_URL (porta 5432)
#   3. Settings → API → copie Project URL e as duas chaves
# =========================================================

# ---- Banco (Supabase Postgres) ----
# Conexão pooled (porta 6543) — usada em runtime pelo Next.js
# Formato: postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta (porta 5432) — usada pelo Prisma Migrate
# (Prisma precisa de conexão sem pgbouncer para criar/aplicar migrations)
DIRECT_URL="postgresql://postgres.PROJECT_REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres"

# ---- Supabase (Storage para upload de vídeos/thumbnails) ----
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ---- NextAuth ----
# Gere com: openssl rand -base64 32
# OBRIGATÓRIO em produção (next start). Em dev é opcional.
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---- Domínio base para subdomínios dos mentorados ----
NEXT_PUBLIC_ROOT_DOMAIN="metodogl.site"
